# EXP React 上級（Next.js）用の環境変数テンプレート
# このファイルをコピーして .env.local を作り、実際のキーを入れる
#   cp .env.local.example .env.local
# .env* は .gitignore 済み。キーは絶対にGitに上げない。

# --- DAY1 で使う ---
# Groq（生成AI / Whisper音声認識）https://console.groq.com/keys
GROQ_API_KEY=

# --- DAY3 で使う ---
# Neon（PostgreSQL）https://console.neon.tech
# DATABASE_URL=

# --- DAY4 で使う ---
# Clerk（認証）https://dashboard.clerk.com
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
# Resend（メール配信）https://resend.com/api-keys
# RESEND_API_KEY=
